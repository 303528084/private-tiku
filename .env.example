# 私有护理题库系统 · 环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env

# 宿主机暴露端口（docker compose 使用；本地直接跑 uvicorn 时用 --port 参数）
TIKU_PORT=8000

# 数据目录（容器内为 /app/data；本地运行时默认 <repo>/data）
TIKU_DATA_DIR=./data

# ---------------------------------------------------------------------------
# 访问门禁（v1.4 T01）
# ---------------------------------------------------------------------------
# 访问口令。**留空 = 关闭门禁**（行为与 v1.3 完全一致，全站无需登录）。
# 填了值之后：除 /api/health 外的接口都需要先在 /login 页输入该口令，
# 浏览器会拿到一个 HttpOnly 会话 Cookie（有效期 7 天）。
# 改这个值 → 已登录的浏览器旧 Cookie 立即失效，需重新输入。
# 建议用 16 位以上随机串，例如：python -c "import secrets;print(secrets.token_urlsafe(24))"
TIKU_ACCESS_TOKEN=

# 应急开关：设为 1 时**跳过**迁移前自动备份（仅在磁盘满等极端情况下临时使用）。
# 正常情况下不要设置——迁移前备份是唯一的回滚手段。
# TIKU_SKIP_MIGRATION_BACKUP=0
