# private-tiku 飞牛 NAS（fnOS）部署变量
#
# 用法：cp .env.example .env  然后按需修改。
# docker compose 会自动读取与本 compose 文件同目录的 .env，无需 --env-file。
# 本文件不含任何凭证：拉取私有镜像的登录信息由 `docker login` 单独管理，不要写在这里。

# ---- 镜像 ----
# 镜像仓库（Docker Hub，私有）。pull 之前需先 docker login -u 303528084
TIKU_IMAGE=303528084/private-tiku
# 标签：latest = 默认分支最新；也可填 sha-xxxxxxxx（CI 每次构建都推）用于回滚，
# 或版本号如 1.2.3 / 1.2
TIKU_TAG=latest

# ---- 网络 ----
# 宿主机对外端口。被占用就改这里（例如 18000）；
# 容器内恒为 8000，改这里不影响 healthcheck
TIKU_PORT=8000

# ---- 数据 ----
# 数据目录：SQLite 库 + 上传的原始文件。
# 相对路径相对于本 compose 文件所在目录解析（默认 => 同目录下的 data/）。
# 不要指向 git 仓库或同步盘目录，会破坏 SQLite 一致性。
TIKU_DATA_PATH=./data

# ---- 时区 ----
# 容器内 python:3.11-slim 自带 tzdata，TZ 会真正生效。
# 不设置会让 datetime('now','localtime') 写成 UTC，时间戳差 8 小时。
TZ=Asia/Shanghai
